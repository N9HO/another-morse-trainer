<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Info.plist. Authored explicitly (GENERATE_INFOPLIST_FILE = NO) because
	  UIBackgroundModes — needed so the Morse tone keeps playing with the screen
	  locked in hands-free Listen mode — has no INFOPLIST_KEY_ build-setting
	  equivalent and so cannot be synthesized. The previously-used
	  `INFOPLIST_KEY_UIBackgroundModes` was silently ignored, leaving the app
	  without the audio background capability.

	  Standard CFBundle* values use $(VAR) so they still track the build settings
	  (version, bundle id, name). Build-environment keys (DT*, CFBundleIcons,
	  CFBundleSupportedPlatforms, UIRequiredDeviceCapabilities, UIDeviceFamily,
	  MinimumOSVersion, …) are injected automatically by the toolchain.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Another Morse Trainer</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The Mac App Store files a Mac Catalyst build under this category
	     (#264); iOS ignores it and takes the category from App Store Connect. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.education</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Used to connect a Bluetooth (BLE MIDI) Morse key or Vail Adapter for keying and the live repeater.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used so you can answer drills by speaking instead of tapping, so the CW decoder can hear the Morse audio you want turned into text, and so the Sending Analyzer can time the tone of a key, keyer or rig you send on.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used to recognize the answer you speak during voice-response training.</string>
	<!--
	  One window. There is one AppModel and one audio engine per process, so a
	  second iPad window (Stage Manager, App Exposé "New Window") would be a
	  second view onto the same session with both driving the same player. The
	  single window still takes part in Split View, Slide Over and Stage
	  Manager resizing; only a second copy of it is ruled out. The Mac build
	  removes File › New Window for the same reason (MacCatalystSupport.swift).
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
	  iPad: all four orientations, and no UIRequiresFullScreen, so the app
	  takes part in Split View, Slide Over and Stage Manager. Nothing in it
	  needs the whole screen: audio, MIDI and the keyer are per-process, not
	  per-window, and every screen lays out down to a compact-width column.
	-->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
