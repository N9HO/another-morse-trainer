# Copy to tools/asc-auth.sh (gitignored) and fill in your values.
#
# NOTE: the Mac's existing clones already carry a filled-in tools/asc-auth.sh —
# being gitignored it never shows up in repo greps, so check for it (or copy it
# from a sibling clone) before concluding the credentials don't exist.
# Bootstrapping a brand-new machine only: Issuer ID + Key ID live at
# App Store Connect → Users and Access → Integrations.
export ASC_KEY_ID="XXXXXXXXXX"
export ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
export ASC_APP_ID="0000000000"
export ASC_BUNDLE_ID="com.example.app"
