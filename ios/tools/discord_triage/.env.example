# Copy to .env for local runs, or set each as a Fly.io secret (see README).
# NEVER commit a filled-in .env — it contains live credentials.

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_BOT_TOKEN=

# Comma-separated channel IDs to watch. Leave blank to watch every channel
# the bot can see. (Enable Developer Mode in Discord to copy channel IDs.)
WATCH_CHANNEL_IDS=

# "react" = only triage when a maintainer reacts with a trigger emoji (recommended).
# "auto"  = triage every non-bot message in the watched channels.
TRIGGER_MODE=react
# One or more trigger emojis, separated by commas or spaces. Reacting with ANY
# of them triggers a triage, e.g. TRIGGER_EMOJI=🐛,✨,🔧
TRIGGER_EMOJI=🐛

# How long (seconds) to let a thread settle before triaging it. Reporters often
# split one report across several messages a few seconds apart, and a maintainer
# may react to the report and to the screenshot under it; the bot waits this long
# so those become one triage and one answer, not one each. The 👀 goes on
# immediately either way. Set to 0 to disable the wait.
TRIAGE_SETTLE_SECONDS=8

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Default is the most capable model. This is a high-volume, low-complexity task,
# so for lower cost set claude-haiku-4-5 (cheapest) or claude-sonnet-5 (mid).
ANTHROPIC_MODEL=claude-opus-5

# Output budget for one triage call, in tokens (1..16000, default 16000). It has
# to hold the WHOLE verdict — the issue body, a follow-up comment, the title and
# the Discord reply — and on a model that thinks by default the thinking comes
# out of it too. Too small does not shorten the issue: it cuts the JSON in half,
# which fails the triage and loses the report. Only what is generated is billed,
# so lowering it saves nothing. Leave it alone unless the logs ask you to.
ANTHROPIC_MAX_TOKENS=16000

# --- GitHub ---
# Fine-grained PAT with Issues: Read and write on the repo(s) below.
GITHUB_TOKEN=
GITHUB_REPO=n9ho/another-morse-trainer
# RETIRED. Both apps live in GITHUB_REPO now, and the old Android repo is
# archived (read-only issue tracker), so there is nothing to route anywhere.
# Leave it unset — config.py ignores it and logs a RuntimeWarning if it is set.
GITHUB_REPO_ANDROID=
# Label applied to every issue the bot opens, so they're easy to filter.
TRIAGE_LABEL=from-discord
