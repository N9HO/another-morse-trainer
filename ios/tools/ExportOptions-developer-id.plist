<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The Mac build for direct download (RELEASE_CHANNEL=developer-id):
         signed with the team's Developer ID Application certificate and
         written to disk, never uploaded. upload-testflight.sh then notarizes
         and staples it. A Mac app downloaded from the web opens only when it
         is Developer ID-signed and notarized; an App Store-signed one does
         not open outside the Mac App Store at all.

         NOT cloud-managed, unlike ExportOptions.plist: xcodebuild with an App
         Store Connect API key, even an Admin one, is refused the
         cloud-managed Developer ID certificate ("Cloud signing permission
         error", 403; Apple bug FB16835802). So signing is manual: the
         Developer ID Application certificate is in the keychain (CI imports
         it from the DEVID_APP_P12 secrets), and upload-testflight.sh fetches
         the profile with `asc-api.py devid-profile` and adds it here as
         provisioningProfiles before exporting. -->
    <key>method</key>
    <string>developer-id</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>F6ASU3CH5M</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Developer ID Application</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
