# Shared
.DS_Store

# ---------------------------------------------------------------------------
# iOS  (ios/)
# ---------------------------------------------------------------------------

# Swift Package Manager
.build/
.swiftpm/

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Sim build output (xcodebuild -derivedDataPath)
build-sim/

# App Store Connect API credentials (local only).
# Re-anchored for the monorepo: as bare `tools/asc-auth.sh` this stopped
# matching once the iOS tree moved under ios/, and the credential file would
# have become committable.
# Glob, not an exact path: a plain `asc-auth.sh` rule leaves backups like
# `asc-auth.sh.bak` committable, and those hold the same credentials.
ios/tools/asc-auth.sh*
!ios/tools/asc-auth.sh.example

# Python bytecode (ios/tools/*.py)
__pycache__/

# ---------------------------------------------------------------------------
# Android  (android/)
# ---------------------------------------------------------------------------

# Secrets — never commit.
# Deliberately left unanchored so they match at any depth, which is what the
# leading-slash entries below could not do after the move.
keystore.properties
*.jks
*.keystore

# Android / Gradle build output.
# These were root-anchored (`/build/`, `/app/build/`, `/local.properties`) in
# the standalone repo. Left alone they would have stopped matching once the
# tree moved under android/, and Gradle output would have started getting
# committed — so each is re-anchored to its new location.
*.iml
.gradle/
/android/local.properties
/android/build/
/android/app/build/
/android/captures/
.externalNativeBuild/
.cxx/

# Kotlin compiler scratch. A .kotlin/errors/errors-*.log was committed in the
# Android repo; it should never have been tracked.
.kotlin/

# Android Studio / IntelliJ
.idea/
