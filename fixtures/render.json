{
  "$comment": "Shared render fixture, consumed by BOTH ports: android MorseSynthTest and ios MorseKitCheck. Data, not code \u2014 see CLAUDE.md's two-ports rule.",
  "derivation": {
    "sampleRate": 44100.0,
    "amplitude": 0.9,
    "rampSeconds": 0.005,
    "segments": "seconds * sampleRate, truncated toward zero, once",
    "envelope": "raised cosine: 0.5*(1-cos(pi*k/ramp)) over ramp = max(1, min(fullRamp, toneSamples/2))",
    "tone": "amplitude * envelope(n) * sin(2*pi*frequency/sampleRate * n), phase restarting at each tone",
    "gap": "silence",
    "note": "Re-implemented from the documented algorithm, not transcribed from either port. It pins the two ports to identical audio and guards the streaming rewrite against changing the sound; it is not a claim about correctness against any external standard.",
    "toleranceNote": "absSumRelative is 1e-6 because the ports store samples as 32-bit floats while these values are computed in double precision: ~1e-7 relative per sample, accumulated over up to half a million of them. Observed drift is ~3e-8 relative; a real regression (a wrong ramp, a dropped segment) moves the sum by percent, not by parts per billion."
  },
  "tolerance": {
    "sample": 1e-06,
    "absSumRelative": 1e-06
  },
