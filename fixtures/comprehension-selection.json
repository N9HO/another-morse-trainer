  "$comment": "Shared Daily Comprehension selection fixture (#353), read by iOS MorseKitCheck, Android and desktop tests. Expected values come from a throwaway Python script written from the spec in docs/daily-comprehension-design.md, NOT from either port. Never regenerate to make a test pass.",
  "derivation": {
    "puzzleNumber": "same as Daily Dit: max(1, daysFromCivil(date) - daysFromCivil(2026-01-01) + 1)",
    "itemIndex": "((puzzleNumber - 1) % itemCount) * selectionStride % itemCount",
    "stride": "selectionStride is coprime with itemCount, so every item is used once per itemCount days",
    "shuffle": "order = [0,1,2,3] indexing [answer, d1, d2, d3]; state = puzzleNumber; for i in 3,2,1: state = (state * 1664525 + 1013904223) mod 2^32; j = (state >> 16) % (i + 1); swap order[i], order[j]. optionOrder[k] is the index into [answer, d1, d2, d3] shown at position k",
    "correctPosition": "position k with optionOrder[k] == 0"
  },
