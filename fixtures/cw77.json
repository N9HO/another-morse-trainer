        "name": "Hi",
        "expected": [
          "N9HO"
        ]
      },
      {
        "why": "a name equal to the callsign is not added twice",
        "callsign": "N9HO",
        "name": "n9ho",
        "expected": [
          "N9HO"
        ]
      }
