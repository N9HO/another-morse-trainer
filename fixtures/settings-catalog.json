  "queries": [
    { "name": "empty query finds nothing", "query": "", "empty": true },
    { "name": "whitespace and punctuation only finds nothing", "query": "  ?/ ", "empty": true },
    { "name": "nonsense finds nothing", "query": "xyzzy", "empty": true },
    { "name": "a synonym finds the side tone", "query": "pitch", "includes": ["sidetone", "toneSpread"] },
    { "name": "case does not matter", "query": "PITCH", "includes": ["sidetone"] },
    { "name": "a word prefix is enough", "query": "notif", "includes": ["dailyReminder"] },
    { "name": "accents are folded", "query": "révéal", "includes": ["reveal", "headCopyReveal"] },
    { "name": "wpm reaches every speed", "query": "wpm", "includes": ["speed", "effectiveSpeed", "callerMinSpeed", "callerMaxSpeed"] },
    { "name": "farnsworth: global first, then callers", "query": "farnsworth", "includes": ["farnsworth", "effectiveSpeed", "callerFarnsworth"], "first": "farnsworth" },
    { "name": "a paddle is the keyer mode", "query": "paddle", "includes": ["keyerMode"] },
    { "name": "vail is the keyer mode", "query": "vail", "includes": ["keyerMode"] },
    { "name": "qrn: the title match outranks the keyword", "query": "qrn", "includes": ["qsoQrn", "bandNoise"], "first": "qsoQrn" },
    { "name": "vibrate finds haptics", "query": "vibrate", "includes": ["haptics"] },
    { "name": "zero: slashed zero before zero-beat", "query": "zero", "includes": ["slashedZero", "toneSpread"], "first": "slashedZero" },
    { "name": "every query word must match", "query": "tone spread", "includes": ["toneSpread"], "excludes": ["sidetone", "previewTone"], "first": "toneSpread" },
    { "name": "delete: scores by title, progress by keyword", "query": "delete", "includes": ["deleteScores", "resetProgress"], "first": "deleteScores" },
    { "name": "british spelling", "query": "licence", "includes": ["licenses"] },
    { "name": "a category title is searchable", "query": "pileups", "includes": ["myCall", "exchange", "cutNumbers"] },
    { "name": "head copy by name", "query": "head copy", "includes": ["headCopyRepeats", "headCopyReveal"], "excludes": ["showReplay"] },
    { "name": "buddy", "query": "buddy", "includes": ["buddyStreak"], "first": "buddyStreak" },
    { "name": "home screen finds the buddy line switch", "query": "home screen", "includes": ["buddyStreak"] },
    { "name": "rst", "query": "rst", "includes": ["rstRequired"], "first": "rstRequired" },
    { "name": "call prefix", "query": "call", "includes": ["myCall", "usOnly", "callsignFormats", "maxCallers"] },
    { "name": "province finds your state (#265)", "query": "province", "includes": ["myState"], "first": "myState" },
    { "name": "sync finds the account (category title)", "query": "sync", "includes": ["account", "devices", "deleteAccount"] },
    { "name": "sign in finds the account by keyword", "query": "sign in", "includes": ["account"] },
    { "name": "email finds the account by keyword", "query": "email", "includes": ["account"] },
    { "name": "delete account by title", "query": "delete account", "includes": ["deleteAccount"], "first": "deleteAccount" },
    { "name": "devices by title", "query": "devices", "includes": ["devices"], "first": "devices" }
  ]
