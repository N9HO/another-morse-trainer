      { "input": "a-b.c_d e!f",      "stored": "ABCDEF" },
      { "input": "abcdefghijklmnop", "stored": "ABCDEFGHIJKL" },
      { "input": "K1ABC/QRP/MM/9X",  "stored": "K1ABC/QRP/MM" },
      { "input": "",                 "stored": "W1AW" },
      { "input": "   ",              "stored": "W1AW" },
      { "input": "!!!",              "stored": "W1AW" },
      { "input": "é",                "stored": "W1AW" },
      { "input": "n9hó",             "stored": "N9H" },
      { "input": "w1aw",             "stored": "W1AW" }
