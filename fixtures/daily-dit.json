{
  "$comment": "Shared Daily Dit fixture, consumed by BOTH ports: android DailyDitTest and ios MorseKitCheck. Data, not code — see CLAUDE.md's two-ports rule. Expected values are derived from the rules below, not captured from either implementation. The puzzles[] block pins real words: regenerating the answer list changes what every player gets on every future day, so it must fail here first.",
  "derivation": {
    "daysFromCivil": "Howard Hinnant days_from_civil; days from 1970-01-01, proleptic Gregorian",
    "puzzleNumber": "max(1, daysFromCivil(date) - daysFromCivil(2026-01-01) + 1), from the LOCAL civil date",
    "answerIndex": "((puzzleNumber - 1) % answerCount) * selectionStride % answerCount",
    "stride": "coprime with answerCount, so every answer is used once before any repeats",
    "score": "pass 1 claims exact matches; pass 2 marks 'present' only while an unclaimed copy of that letter remains in the answer",
    "wpm": "max(minimumWpm, startingWpm - speedStepWpm * floor(guessesUsed / guessesPerSpeedStep))",
    "shareText": "headline, then one emoji row per guess, then the link"
  },
